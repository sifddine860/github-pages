<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Translator</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: linear-gradient(135deg, #667eea, #764ba2);
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        .container {
            background: white;
            padding: 20px;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
            text-align: center;
            width: 400px;
        }

        h1 {
            color: #333;
            margin-bottom: 15px;
        }

        .translator-box {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .language-select {
            display: flex;
            justify-content: center;
            gap: 10px;
        }

        select, button, textarea {
            font-size: 16px;
            padding: 10px;
            border-radius: 8px;
            border: 1px solid #ccc;
        }

        button {
            cursor: pointer;
            background-color: #667eea;
            color: white;
            border: none;
            transition: 0.3s;
        }

        button:hover {
            background-color: #5a67d8;
        }

        textarea {
            width: 100%;
            height: 100px;
            resize: none;
            border: 1px solid #ddd;
        }

        #output-text {
            background: #f4f4f4;
            color: #333;
        }

        /* RTL Support for Arabic */
        [dir="rtl"] textarea {
            direction: rtl;
            text-align: right;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Translator</h1>
        <div class="translator-box">
            <div class="language-select">
                <select id="from-language">
                    <option value="en">English</option>
                    <option value="fr">French</option>
                    <option value="es">Spanish</option>
                    <option value="de">German</option>
                    <option value="ar">Arabic</option>
                </select>
                <button id="swap">⇄</button>
                <select id="to-language">
                    <option value="fr">French</option>
                    <option value="en">English</option>
                    <option value="es">Spanish</option>
                    <option value="de">German</option>
                    <option value="ar">Arabic</option>
                </select>
            </div>
            <textarea id="input-text" placeholder="Enter text..."></textarea>
            <button id="translate-btn">Translate</button>
            <textarea id="output-text" placeholder="Translation..." readonly></textarea>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const inputText = document.getElementById("input-text");
            const outputText = document.getElementById("output-text");
            const fromLang = document.getElementById("from-language");
            const toLang = document.getElementById("to-language");
            const translateBtn = document.getElementById("translate-btn");
            const swapBtn = document.getElementById("swap");

            // Swap languages
            swapBtn.addEventListener("click", () => {
                let temp = fromLang.value;
                fromLang.value = toLang.value;
                toLang.value = temp;
            });

            // Clear translation when input is empty
            inputText.addEventListener("input", () => {
                if (inputText.value.trim() === "") {
                    outputText.value = "";
                }
            });

            // Translate function (Google Translate API)
            translateBtn.addEventListener("click", async () => {
                let text = inputText.value.trim();
                if (text === "") {
                    outputText.value = "";  // Clear translation if input is empty
                    return;
                }

                let sourceLang = fromLang.value;
                let targetLang = toLang.value;

                let url = `https://translate.googleapis.com/translate_a/single?client=gtx&sl=${sourceLang}&tl=${targetLang}&dt=t&q=${encodeURIComponent(text)}`;

                try {
                    let response = await fetch(url);
                    let data = await response.json();
                    outputText.value = data[0].map(item => item[0]).join("");

                    // Adjust direction for Arabic text
                    if (targetLang === "ar") {
                        outputText.setAttribute("dir", "rtl");
                    } else {
                        outputText.setAttribute("dir", "ltr");
                    }
                } catch (error) {
                    outputText.value = "Translation error.";
                }
            });
        });
    </script>
</body>
</html>
